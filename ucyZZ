local function sliderRow(parent, setting, values, onChange, order)
	local long = (utf8.len(setting.name) or #setting.name) > 15
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, long and 38 or 24), BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
	local nameL = label(setting.name, 11, Theme.sub, false)
	nameL.TextTruncate = Enum.TextTruncate.AtEnd; nameL.Parent = row
	local valL = label("", 11, Theme.text, true)
	valL.TextXAlignment = Enum.TextXAlignment.Right; valL.Parent = row
	local track
	if long then
		nameL.Size = UDim2.new(1, -46, 0, 16)
		valL.AnchorPoint = Vector2.new(1, 0); valL.Position = UDim2.new(1, 0, 0, 0); valL.Size = UDim2.new(0, 44, 0, 16)
		track = new("Frame", { Position = UDim2.new(0, 0, 0, 25), Size = UDim2.new(1, 0, 0, 4), BackgroundColor3 = Color3.fromRGB(48, 48, 54), BorderSizePixel = 0, Parent = row }, { corner(2) })
	else
		nameL.Size = UDim2.new(0.44, 0, 1, 0)
		valL.AnchorPoint = Vector2.new(1, 0.5); valL.Position = UDim2.new(1, 0, 0.5, 0); valL.Size = UDim2.new(0, 40, 0, 16)
		track = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.46, 0, 0.5, 0), Size = UDim2.new(0.54, -46, 0, 4), BackgroundColor3 = Color3.fromRGB(48, 48, 54), BorderSizePixel = 0, Parent = row }, { corner(2) })
	end
	local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = track }, { corner(2) })
	grad(fill, 0)
	local knob = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = track }, { corner(5) })
	local function set(v, silent)
		v = math.clamp(v, setting.min, setting.max)
		local step = setting.step or 1
		v = math.clamp(math.floor(v / step + 0.5) * step, setting.min, setting.max)
		values[setting.key] = v
		local a = (v - setting.min) / (setting.max - setting.min)
		fill.Size = UDim2.new(a, 0, 1, 0)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		valL.Text = tostring(math.floor(v * 100 + 0.5) / 100)
		if not silent and onChange then onChange(v) end
	end
	set(values[setting.key] ~= nil and values[setting.key] or setting.default, true)
	local function fromInput(i)
		set(setting.min + (setting.max - setting.min) * math.clamp((i.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1))
	end
	row.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragFn = fromInput; fromInput(i)
		end
	end)
	return row
end

