local function weather3d(name, desc, c)
	local fl = {}
	local function K(v) local a = c.arms; if type(a) == "function" then return a(v) end return a or 1 end
	local settings = {
		{ name = "Количество", key = "n", min = 20, max = 600, default = c.n, step = 10 },
		{ name = "Скорость", key = "sp", min = 0.2, max = 3, default = 1, step = 0.1 },
		{ name = "Размер", key = "sz", min = 0.3, max = 3, default = 1, step = 0.1 },
		{ name = "Ветер", key = "wind", min = -40, max = 40, default = c.wind or 0, step = 1 },
		{ name = "Дальность", key = "R", min = 20, max = 90, default = c.R or 45, step = 5 },
	}
	for _, e in ipairs(c.extra or {}) do table.insert(settings, e) end
	local ymin, ymax = c.ymin or -10, c.ymax or 30
	fx3d(name, desc, settings, {
		cam = true,
		count = function(v) return v.n * K(v) end,
		make = function(i, v)
			local k = K(v)
			if i == 1 then fl = {} end
			local f, a = (i - 1) // k + 1, (i - 1) % k
			local F = fl[f]
			if not F then
				local o = cam().CFrame.Position
				F = {
					p = o + Vector3.new((math.random() * 2 - 1) * v.R, ymin + math.random() * (ymax - ymin), (math.random() * 2 - 1) * v.R),
					sp = 0.7 + math.random() * 0.6, w = 1 + math.random() * 2, ph = math.random() * TAU,
					r1 = math.random() * TAU, r2 = math.random() * TAU, s1 = (math.random() - 0.5) * 3, s2 = (math.random() - 0.5) * 3,
					hue = math.random() * 360, vel = Vector3.new(0, -1, 0),
				}
				fl[f] = F
			end
			return c.part(v, a, F)
		end,
		step = function(i, v, t, n, o, r, dt)
			local k = K(v)
			local f, a = (i - 1) // k + 1, (i - 1) % k
			local F = fl[f]
			if not F then return CFrame.new(o) end
			if a == 0 then
				local sway = c.sway or 0.6
				local vx = v.wind * (c.windk or 0.4) + math.sin(t * F.w + F.ph) * sway
				local vz = math.cos(t * F.w * 0.9 + F.ph) * sway
				local vy = c.vy * v.sp * F.sp + (c.vsway and math.sin(t * F.w * 0.7 + F.ph) * c.vsway or 0)
				F.vel = Vector3.new(vx, vy, vz)
				local rel = F.p + F.vel * dt - o
				local R2 = v.R * 2
				rel = Vector3.new((rel.X + v.R) % R2 - v.R, (rel.Y - ymin) % (ymax - ymin) + ymin, (rel.Z + v.R) % R2 - v.R)
				F.p = o + rel
			end
			local cf
			if c.upright then
				cf = CFrame.new(F.p)
			elseif c.orient == "vel" then
				cf = CFrame.lookAt(F.p, F.p + F.vel)
			else
				local sp = c.spin or 1
				cf = CFrame.new(F.p) * CFrame.Angles(F.r1 + t * F.s1 * sp, F.r2 + t * F.s2 * sp, 0) * CFrame.Angles(0, 0, a * PI / k)
			end
			local tr
			if c.blink then tr = 0.15 + 0.6 * math.abs(math.sin(t * F.w + F.ph)) end
			return cf, nil, tr
		end,
	})
end

local function pp(shape, size, color, tr, mat)
	local p = P(shape, size, mat)
	p.Color = color; p.Transparency = tr or 0
	return p
end

