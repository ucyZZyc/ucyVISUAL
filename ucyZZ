local fpsSmooth, accum, themeT = 60, 0, 0
RunService.RenderStepped:Connect(function(dt)
	if unloaded then return end
	if Theme.anim then
		themeT += dt
		if themeT > 0.1 then
			themeT = 0
			local h = os.clock() * 40
			Theme.c1, Theme.c2 = hsv(h, 0.7, 1), hsv(h + 90, 0.75, 1)
			Theme.accent, Theme.accent2 = Theme.c1, Theme.c2
			for _, g in ipairs(gradients) do if g.Parent then g.Color = gradSeq() end end
		end
	end
	for _, m in ipairs(moduleList) do
		if m.enabled and m.def.onRender then
			local ok, err = pcall(m.def.onRender, dt, m.values)
			if not ok then
				warn("[ucyVISUAL] " .. m.name .. ": " .. tostring(err))
				m.set(false)
			end
		end
	end
	fpsSmooth = fpsSmooth + (1 / math.max(dt, 1e-4) - fpsSmooth) * 0.1
	accum += dt
	if accum > 0.25 then
		accum = 0
		local ping = 0
		pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
		local c, c2 = Theme.c1, Theme.c2
		wmText.Text = string.format('<font color="rgb(%d,%d,%d)">ucy</font>VISUAL', math.floor(c.R * 255), math.floor(c.G * 255), math.floor(c.B * 255))
		local sep = '  <font color="rgb(100,100,108)">•</font>  '
		local parts = {}
		if wmOpt.nm == 1 then parts[#parts + 1] = '<font color="rgb(235,235,240)">' .. string.gsub(player.DisplayName, "[<&]", "") .. '</font>' end
		parts[#parts + 1] = string.format('<font color="rgb(%d,%d,%d)">%d</font> FPS', math.floor(c2.R * 255), math.floor(c2.G * 255), math.floor(c2.B * 255), fpsSmooth)
		parts[#parts + 1] = string.format('<font color="rgb(%d,%d,%d)">%d</font> ms', math.floor(c2.R * 255), math.floor(c2.G * 255), math.floor(c2.B * 255), ping)
		if wmOpt.tm == 1 then parts[#parts + 1] = os.date("%H:%M") end
		wmSub.Text = table.concat(parts, sep)
	end
end)

