local function preset(name, desc, cfg)
	local list = {}
	local function mk(class, props)
		local e = new(class, { Name = "PV_" .. string.gsub(name, "%s", ""), Enabled = false, Parent = Lighting })
		for k, val in pairs(props) do e[k] = val end
		table.insert(list, e)
	end
	if cfg.cc then mk("ColorCorrectionEffect", cfg.cc) end
	if cfg.bloom then mk("BloomEffect", cfg.bloom) end
	if cfg.dof then mk("DepthOfFieldEffect", cfg.dof) end
	if cfg.blur then mk("BlurEffect", { Size = cfg.blur }) end
	if cfg.rays then mk("SunRaysEffect", cfg.rays) end
	mod("Screen", {
		name = name, desc = desc,
		onEnable = function() for _, e in ipairs(list) do e.Enabled = true end end,
		onDisable = function() for _, e in ipairs(list) do e.Enabled = false end end,
	})
end
