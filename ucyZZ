			return Vector3.new(bx + (hash(slot * 7 + kk, b) - 0.5) * 2 * amp, o.Y - 3 + v.h * (1 - f), bz + (hash(kk, slot + b * 3) - 0.5) * 2 * amp)
		end
		local p1, p2 = pt(k), pt(k + 1)
		part.Size = Vector3.new(v.w, v.w, (p2 - p1).Magnitude + 0.05)
		local tr = 1
		if phase < 0.25 then tr = hash(slot, b) > 0.35 and 0.05 or 0.6 end
		return CFrame.lookAt((p1 + p2) / 2, p2), hc(v, 0, t), tr
	end,
})

