			Font = Enum.Font.GothamBold, TextSize = 26, TextStrokeTransparency = 0.4, Visible = false,
		})
	end)
	mod("MM2", {
		name = "Offscreen Arrows", desc = "Стрелки по краю экрана к игрокам вне поля зрения",
		settings = {
			{ name = "Отступ от центра", key = "pad", min = 30, max = 200, default = 70, step = 5 },
			{ name = "Невиновные (0/1)", key = "inn", min = 0, max = 1, default = 0 },
			{ name = "Монохром (0/1)", key = "mono", min = 0, max = 1, default = 0 },
		},
		onRender = function(dt, v)
			local c = cam()
			local vp = c.ViewportSize
			local center = vp / 2
			local rad = math.min(vp.X, vp.Y) / 2 - v.pad
			local n = 0
			for _, d in ipairs(visibleTargets(v)) do
				local sp, on = c:WorldToViewportPoint(d.root.Position)
