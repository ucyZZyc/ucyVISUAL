local function mm2Role(plr)
	local c, b = plr.Character, plr:FindFirstChildOfClass("Backpack")
	if (c and c:FindFirstChild("Knife")) or (b and b:FindFirstChild("Knife")) then return "Murderer" end
	if (c and c:FindFirstChild("Gun")) or (b and b:FindFirstChild("Gun")) then return "Sheriff" end
	return "Innocent"
end
local roleColor = { Murderer = Color3.fromRGB(255, 70, 70), Sheriff = Color3.fromRGB(80, 150, 255), Innocent = Color3.fromRGB(235, 235, 235) }
local roleMonoColor = { Murderer = Color3.fromRGB(255, 255, 255), Sheriff = Color3.fromRGB(170, 170, 175), Innocent = Color3.fromRGB(90, 90, 95) }
local roleRu = { Murderer = "Убийца", Sheriff = "Шериф", Innocent = "Мирный" }
local function colorOfRole(role, mono) return (mono == 1 and roleMonoColor or roleColor)[role] end

