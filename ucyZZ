local mmSnapshot, mmSnapT, roleCache = {}, 0, {}
Players.PlayerRemoving:Connect(function(p) roleCache[p] = nil end)
local function mmSnap()
	local now = os.clock()
	if now - mmSnapT < 0.15 then return mmSnapshot end
	mmSnapT = now
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		local r = c and c:FindFirstChild("HumanoidRootPart")
		if c and h and r and h.Health > 0 then
			local role = mm2Role(p)
			local rc = roleCache[p]
			if role ~= "Innocent" then roleCache[p] = { char = c, role = role }
			elseif rc and rc.char == c then role = rc.role end
			list[#list + 1] = { plr = p, char = c, root = r, hum = h, head = c:FindFirstChild("Head") or r, role = role, tool = c:FindFirstChildOfClass("Tool") }
		else
			roleCache[p] = nil
		end
	end
	mmSnapshot = list
	return list
end
local function mmFind(role)
	for _, d in ipairs(mmSnap()) do if d.role == role then return d end end
