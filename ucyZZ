local function hrp() local c = player.Character return c and c:FindFirstChild("HumanoidRootPart") end
local function hum() local c = player.Character return c and c:FindFirstChildOfClass("Humanoid") end
local function cam() return workspace.CurrentCamera end

local function fx(tab, name, desc, class, settings, apply)
	local inst = new(class, { Name = "PV_" .. string.gsub(name, "%s", ""), Parent = Lighting })
	inst.Enabled = false
	mod(tab, {
		name = name, desc = desc, settings = settings,
		onEnable = function(v) inst.Enabled = true; if apply then apply(inst, v) end end,
		onChange = function(v) if apply then apply(inst, v) end end,
		onDisable = function() inst.Enabled = false end,
	})
	return inst
end

local function lightMod(tab, name, desc, settings, props, apply, render)
	local backup
	return mod(tab, {
		name = name, desc = desc, settings = settings,
		onEnable = function(v)
			backup = {}
			for _, p in ipairs(props) do backup[p] = Lighting[p] end
			if apply then apply(v) end
		end,
		onChange = function(v) if apply then apply(v) end end,
		onDisable = function()
			if backup then for p, val in pairs(backup) do Lighting[p] = val end end
			backup = nil
		end,
		onRender = render,
	})
end

local function particleWorld(name, desc, cfg)
	local part, emitter
	mod("Effects", {
		name = name, desc = desc,
		settings = { { name = "Количество", key = "rate", min = 10, max = 600, default = cfg.rate, step = 10 } },
		onEnable = function(v)
			part = new("Part", {
				Name = "PV_" .. name, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
				Transparency = 1, Size = cfg.box, Parent = cam(),
			})
			emitter = new("ParticleEmitter", {
				Rate = v.rate, Lifetime = cfg.life, Speed = cfg.speed, Size = cfg.size, Transparency = cfg.trans,
				Color = cfg.color, LightEmission = cfg.glow, Acceleration = cfg.accel, EmissionDirection = cfg.dir,
				SpreadAngle = Vector2.new(15, 15), Texture = "rbxasset://textures/particles/sparkles_main.dds",
				RotSpeed = NumberRange.new(-60, 60), Orientation = cfg.orient or Enum.ParticleOrientation.FacingCamera, Parent = part,
			})
		end,
		onRender = function()
			if part then part.CFrame = CFrame.new(cam().CFrame.Position + Vector3.new(0, cfg.height, 0)) end
		end,
		onChange = function(v) if emitter then emitter.Rate = v.rate end end,
		onDisable = function() if part then part:Destroy() end part, emitter = nil, nil end,
	})
end

local function charFx(name, desc, settings, build, extra)
	local made = {}
	local function clear()
		for _, o in ipairs(made) do pcall(function() o:Destroy() end) end
		made = {}
	end
	local function rebuild(v)
		clear()
		local c = player.Character
		local r = c and c:FindFirstChild("HumanoidRootPart")
		if c and r then made = build(v, c, r) or {} end
	end
	local def = { name = name, desc = desc, settings = settings, onEnable = rebuild, onChange = rebuild, onChar = rebuild, onDisable = clear }
	for k, fn in pairs(extra or {}) do def[k] = fn end
	return mod("Player", def)
end

-- 2D линии (пул Frame)
local function newPool(parent, maker)
	local pool = {}
	return {
		get = function(i)
			if not pool[i] then pool[i] = maker(); pool[i].Parent = parent end
			return pool[i]
		end,
		hideFrom = function(i) for k = i, #pool do pool[k].Visible = false end end,
		clear = function() for _, o in ipairs(pool) do o:Destroy() end pool = {} end,
	}
end
local function lineMaker() return new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Visible = false }) end
local function setLine(l, a, b, w, col, tr)
	local d = b - a
	l.Size = UDim2.fromOffset(d.Magnitude, w)
	l.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
	l.Rotation = math.deg(math.atan2(d.Y, d.X))
	l.BackgroundColor3 = col
	l.BackgroundTransparency = tr or 0.1
	l.Visible = true
end

