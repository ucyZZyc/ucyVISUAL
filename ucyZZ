do
	local orig
	mod("Camera", {
		name = "FOV Changer", desc = "Изменить угол обзора камеры",
		settings = { { name = "FOV", key = "fov", min = 30, max = 120, default = 90 } },
		onEnable = function() orig = cam().FieldOfView end,
