-- охрана = любые модели с Humanoid, которые не являются игроками (скан в фоне, без лагов)
local guardList, guardT, guardBusy = {}, -10, false
local function scanGuards()
	if not guardBusy and os.clock() - guardT > 4 then
		guardBusy = true
		task.spawn(function()
			pcall(function()
				local out, n = {}, 0
				for _, d in ipairs(workspace:GetDescendants()) do
					if d:IsA("Humanoid") then
						local m = d.Parent
						if m and m:IsA("Model") and not Players:GetPlayerFromCharacter(m) and m:FindFirstChild("HumanoidRootPart") then
							out[#out + 1] = { char = m, hum = d }
						end
					end
					n += 1
					if n % 1500 == 0 then task.wait() end
				end
				guardList = out
			end)
			guardT = os.clock(); guardBusy = false
		end)
	end
	return guardList
end

local inkSnapshot, inkSnapT = {}, 0
local function inkSnap()
	local now = os.clock()
	if now - inkSnapT < 0.15 then return inkSnapshot end
	inkSnapT = now
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local c = p.Character
			local h = c and c:FindFirstChildOfClass("Humanoid")
			local r = c and c:FindFirstChild("HumanoidRootPart")
			if c and h and r and h.Health > 0 then
				list[#list + 1] = { kind = "Player", name = p.DisplayName, plr = p, char = c, root = r, hum = h, head = c:FindFirstChild("Head") or r }
			end
		end
	end
	for _, g in ipairs(scanGuards()) do
		if g.char.Parent and g.hum.Health > 0 then
			local r = g.char:FindFirstChild("HumanoidRootPart")
			if r then list[#list + 1] = { kind = "Guard", name = g.char.Name, char = g.char, root = r, hum = g.hum, head = g.char:FindFirstChild("Head") or r } end
		end
	end
	inkSnapshot = list
	return list
end
local function inkTargets(v)
	local out = {}
	for _, d in ipairs(inkSnap()) do
