local function showHint(m) hintL.Text = m.name .. (m.def.desc and ("  -  " .. m.def.desc) or "") end

local function buildCard(m)
	if m.card then return end
	local pg = pages[m.tab]
	local ci = (pg.h[1] <= pg.h[2]) and 1 or 2
	local nset = #(m.def.settings or {})
	pg.h[ci] += 90 + nset * 28
	local card = newCard(pg.cols[ci], m.idx)
	m.card, m.col = card, pg.cols[ci]
	local title = cardTitle(card, m.name)
	m.titleGrad = grad(title, 0); m.titleGrad.Enabled = false
	title.Active = true
	title.MouseEnter:Connect(function() showHint(m) end)
	local _, setEn = toggleRow(card, "Enabled", 1, function(on) m.set(on) end)
	m.setEnVisual = setEn
	local br = new("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, LayoutOrder = 2, Parent = card })
	local bl = label("Bind", 12, TXT, false)
	bl.Size = UDim2.new(0.5, 0, 1, 0); bl.Parent = br
	local bb = sk("field", new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 78, 0, 18), BackgroundColor3 = Theme.field,
		BorderSizePixel = 0, Text = "None", TextSize = 11, TextColor3 = Theme.text, Font = Enum.Font.GothamBold, AutoButtonColor = false, Parent = br,
	}, { corner(5) }))
	m.bindBtn = bb
	bb.MouseButton1Click:Connect(function() listening = m; m.updateBind() end)
	bb.MouseButton2Click:Connect(function() m.bind = nil; m.updateBind() end)
	for idx, s in ipairs(m.def.settings or {}) do
		if s.min == 0 and s.max == 1 and (s.step == nil or s.step == 1) then
			local name = string.gsub(s.name, "%s*%(0/1%)", "")
			local _, setv
			_, setv = toggleRow(card, name, 2 + idx, function(on)
				m.values[s.key] = on and 1 or 0
				setv(on)
				if m.enabled and m.def.onChange then safe(m.def.onChange, m.values) end
			end)
			setv((m.values[s.key] or s.default) == 1)
		else
			sliderRow(card, s, m.values, function()
				if m.enabled and m.def.onChange then safe(m.def.onChange, m.values) end
			end, 2 + idx)
		end
	end
	m.refreshVisual()
	m.updateBind()
end

