				if not inside then
					local rel = c.CFrame:PointToObjectSpace(d.root.Position)
					local ang = math.atan2(rel.X, -rel.Z)
					n += 1
					local a = pool.get(n)
					a.Position = UDim2.fromOffset(center.X + math.sin(ang) * rad, center.Y - math.cos(ang) * rad)
					a.Rotation = math.deg(ang)
					a.TextColor3 = colorOfRole(d.role, v.mono)
					a.Visible = true
				end
			end
			pool.hideFrom(n + 1)
		end,
		onDisable = function() pool.clear() end,
	})
