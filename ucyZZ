			local sc = v.shape == 0 and v.r * 0.577 or v.r
			return P(BLOCK, Vector3.new(v.w, v.w, v.shape == 0 and 2 * sc or 1.4142 * sc))
		end,
		step = function(i, v, t, n, o)
			local E = getEdges(v.shape)[i]
			local sc = v.shape == 0 and v.r * 0.577 or v.r
			local basis = CFrame.Angles(t * 0.6 * v.s, t * 0.9 * v.s, t * 0.4 * v.s)
			local p1, p2 = o + basis * (E[1] * sc), o + basis * (E[2] * sc)
			return CFrame.lookAt((p1 + p2) / 2, p2), hc(v, i, t, 10)
		end,
	})
end

