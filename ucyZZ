local soundChoice, soundVol, soundOn, soundReady = 1, 0.6, true, false
local function playSound(id, pitch)
	if not soundOn or not soundReady then return end
	pcall(function()
		local s = Instance.new("Sound")
		s.SoundId = id; s.Volume = soundVol; s.PlaybackSpeed = pitch or 1
		s.Parent = SoundService
		s:Play()
		Debris:AddItem(s, 4)
	end)
end
local function playOpenSound(opening)
	local id = (CUSTOM_OPEN_SOUND ~= "" and CUSTOM_OPEN_SOUND) or soundIds[soundChoice] or soundIds[1]
	if opening then
		playSound(id, 1.5)
		task.delay(0.07, function() playSound(id, 2.1) end)
	else
		playSound(id, 1.0)
	end
end

