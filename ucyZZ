	local refreshCfg
	local function doSave(name)
		name = sanitize(name)
		if name == "" then name = "default" end
		if writeConfig(name, snapshot()) then
			currentConfig = name
			nameBox.Text = name
			toast("Config saved: " .. name, true)
			refreshCfg()
		else
			toast("Could not save config", false)
		end
	end
	function refreshCfg()
		for _, o in ipairs(cfgDyn) do o:Destroy() end
		cfgDyn = {}
		for i, n in ipairs(listConfigs()) do
			local b = flatButton(list, ((n == currentConfig) and "> " or "") .. n .. ((n == autoName) and "   [auto]" or ""), i)
			b.TextXAlignment = Enum.TextXAlignment.Left
			new("UIPadding", { PaddingLeft = UDim.new(0, 10), Parent = b })
			b.MouseButton1Click:Connect(function()
				local d = readConfig(n)
				if d and applyConfig(d) then
