--[[
	ucyVISUAL — Key System (клиентская часть)
	------------------------------------------------------------
	Вставь этот блок в САМОЕ НАЧАЛО основного скрипта, перед local function boot().
	Перед вызовом boot() добавь: if not UCY_KEY_OK then return end

	Один ключ привязывается навсегда к первому Roblox-аккаунту (UserId), который его ввёл.
	Срок действия ключа задаёшь сам при генерации (admin.html или ссылка generate).
]]

local API_URL = "https://script.google.com/macros/s/AKfycbzBi9c0lxTHUdGDTNwy7w28GKkbyv36bGXuxPLmZpfQao9pqDsKWQHMUNbXZv_D4-MJ/exec"
local player = game:GetService("Players").LocalPlayer

local function httpGet(url)
	local ok, res = pcall(function()
		if syn and syn.request then
			return syn.request({ Url = url, Method = "GET" }).Body
		elseif http_request then
			return http_request({ Url = url, Method = "GET" }).Body
		elseif request then
			return request({ Url = url, Method = "GET" }).Body
		else
			return game:HttpGet(url)
		end
	end)
	return ok and res or nil
end

local function savedKeyPath() return "ucyVISUAL/key.txt" end
local function loadSavedKey()
	local ok, v = pcall(function()
		if isfile and isfile(savedKeyPath()) then return readfile(savedKeyPath()) end
	end)
	return (ok and v) or nil
end
local function saveKey(k)
	pcall(function()
		if makefolder and not isfolder("ucyVISUAL") then makefolder("ucyVISUAL") end
		if writefile then writefile(savedKeyPath(), k) end
	end)
end

local function validateKey(key)
	local url = API_URL .. "?action=validate&key=" .. HttpService:UrlEncode(key)
		.. "&userid=" .. tostring(player.UserId) .. "&username=" .. HttpService:UrlEncode(player.Name)
	local body = httpGet(url)
	if not body then return false, "network" end
	local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
	if not ok or type(data) ~= "table" then return false, "bad_response" end
	return data.ok == true, data.reason
end

