		txt.TextXAlignment = Enum.TextXAlignment.Right; txt.Parent = row
		local track = new("Frame", { Position = UDim2.new(0, 8, 0, 21), Size = UDim2.new(1, -16, 0, 4), BackgroundColor3 = Theme.rowoff or Color3.fromRGB(40, 40, 43), BorderSizePixel = 0, Parent = row }, { corner(2) })
		local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = track }, { corner(2) })
		grad(fill, 0)
		active[name] = { t0 = os.clock(), dur = math.max(dur, 0.2), row = row, fill = fill, txt = txt, done = false }
	end
	local function hook(tool)
		if hooked[tool] then return end
		local list = {}
		hooked[tool] = list
		table.insert(list, tool.Activated:Connect(function() startCd(tool.Name, expected(tool.Name)) end))
		table.insert(list, tool:GetPropertyChangedSignal("Enabled"):Connect(function()
			local a = active[tool.Name]
			if not tool.Enabled then
				if not a or a.done then startCd(tool.Name, expected(tool.Name)) end
			elseif a and not a.done then
				learned[tool.Name] = math.max(os.clock() - a.t0, 0.2)
				a.dur = learned[tool.Name]
			end
		end))
	end
	local function scan()
		local bp = player:FindFirstChildOfClass("Backpack")
		for _, holderObj in ipairs({ bp, player.Character }) do
			if holderObj then
				for _, t in ipairs(holderObj:GetChildren()) do if t:IsA("Tool") then hook(t) end end
			end
		end
	end
	local function clear()
		for _, a in pairs(active) do pcall(function() a.row:Destroy() end) end
		active = {}
		for _, list in pairs(hooked) do for _, c in ipairs(list) do c:Disconnect() end end
		hooked = {}
	end
	mod("MM2", {
		name = "Cooldowns", desc = "Таймеры перезарядки: бомба, нож, пистолет. Время можно подстроить; если предмет сам блокируется на время кулдауна, оно определяется автоматически",
		settings = {
			{ name = "Бомба (сек)", key = "bomb", min = 1, max = 60, default = 10 },
			{ name = "Нож / бросок (сек)", key = "knife", min = 1, max = 60, default = 5 },
			{ name = "Пистолет (сек)", key = "gun", min = 1, max = 60, default = 3 },
			{ name = "Другие предметы (сек)", key = "other", min = 1, max = 60, default = 5 },
			{ name = "Уведомление «готово» (0/1)", key = "alert", min = 0, max = 1, default = 0 },
		},
		onEnable = function(v) cfgV = v; holder.Visible = true; scan() end,
		onChange = function(v) cfgV = v end,
		onRender = function(dt, v)
			cfgV = v
			local now = os.clock()
			if now - scanT > 0.5 then scanT = now; scan() end
			for name, a in pairs(active) do
				local rem = a.dur - (now - a.t0)
				if rem > 0 then
					a.fill.Size = UDim2.new(math.clamp(1 - rem / a.dur, 0, 1), 0, 1, 0)
					a.txt.Text = string.format("%.1fs", rem)
				else
					if not a.done then
						a.done = true; a.doneT = now
						a.fill.Size = UDim2.new(1, 0, 1, 0)
						a.txt.Text = "ГОТОВО"
						if v.alert == 1 then notify(name .. ": готово", true) end
					end
					if now - a.doneT > 1 then a.row:Destroy(); active[name] = nil end
				end
			end
		end,
		onDisable = function() holder.Visible = false; clear() end,
	})
end

