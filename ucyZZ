local gradients = {}
local function gradSeq() return ColorSequence.new(Theme.c1, Theme.c2) end
local function grad(parent, rot)
	local g = Instance.new("UIGradient")
	g.Color = gradSeq()
	g.Rotation = rot or 0
	g.Parent = parent
	table.insert(gradients, g)
	return g
end
local themeHooks, glassList = {}, {}
local function setPalette(i)
	local p = Palettes[i]
	Theme.anim = p[1] == "Rainbow"
	Theme.index = i
	Theme.c1, Theme.c2, Theme.accent, Theme.accent2 = p[2], p[3], p[2], p[3]
	local bg, white = p[4] or Color3.fromRGB(12, 12, 13), Color3.new(1, 1, 1)
	Theme.bg = bg
	Theme.card = bg:Lerp(white, 0.02)
	Theme.field = bg:Lerp(white, 0.07)
	Theme.line = bg:Lerp(white, 0.16)
	Theme.rowoff = bg:Lerp(white, 0.14)
	Theme.rowhover = bg:Lerp(white, 0.2)
	Theme.exp = bg:Lerp(white, 0.06)
	for _, g in ipairs(gradients) do if g.Parent then g.Color = gradSeq() end end
	for _, fn in ipairs(themeHooks) do pcall(fn) end
end

local function tween(obj, t, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function new(class, props, children)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	for _, c in ipairs(children or {}) do c.Parent = o end
	return o
end

local function corner(r) return new("UICorner", { CornerRadius = UDim.new(0, r) }) end

local function label(text, size, color, bold)
	return new("TextLabel", {
		BackgroundTransparency = 1, Text = text, TextSize = size, TextColor3 = color or Theme.text,
		Font = bold and Enum.Font.GothamBold or Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left,
	})
end

local function safe(fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then warn("[ucyVISUAL] " .. tostring(err)) end
	return ok
end

local function glass(frame, radius, transparency)
	frame.BackgroundColor3 = Theme.bg
	frame.BackgroundTransparency = transparency or 0.15
	frame.BorderSizePixel = 0
	corner(radius or 8).Parent = frame
	new("UIStroke", { Thickness = 1, Color = Theme.line, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = frame })
	table.insert(glassList, frame)
	return frame
end
table.insert(themeHooks, function()
	for i = #glassList, 1, -1 do
		local f = glassList[i]
		if f.Parent then
			f.BackgroundColor3 = Theme.bg
			local st = f:FindFirstChildOfClass("UIStroke")
			if st then st.Color = Theme.line end
		else
			table.remove(glassList, i)
		end
	end
end)

