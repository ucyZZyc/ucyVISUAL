do -- Wire Shape
	local cache = {}
	local function getEdges(shape)
		if cache[shape] then return cache[shape] end
		local V, E = {}, {}
		if shape == 0 then
			for _, x in ipairs({ -1, 1 }) do for _, y in ipairs({ -1, 1 }) do for _, z in ipairs({ -1, 1 }) do V[#V + 1] = Vector3.new(x, y, z) end end end
			for a = 1, #V do for b = a + 1, #V do if math.abs((V[a] - V[b]).Magnitude - 2) < 1e-3 then E[#E + 1] = { V[a], V[b] } end end end
		else
			V = { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 1, 0), Vector3.new(0, -1, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) }
			for a = 1, #V do for b = a + 1, #V do if (V[a] + V[b]).Magnitude > 0.5 then E[#E + 1] = { V[a], V[b] } end end end
		end
		cache[shape] = E
		return E
	end
	fx3d("Wire Shape", "Вращающийся каркас вокруг вас: куб или октаэдр", S3({
		{ name = "Фигура (0 куб / 1 октаэдр)", key = "shape", min = 0, max = 1, default = 0 },
