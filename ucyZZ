-- HITBOX
---------------------------------------------------------------------
local function wire(adornee, color, parent, onTop)
	local ok, w = pcall(function()
		return new("WireframeHandleAdornment", { Adornee = adornee, Color3 = color, AlwaysOnTop = onTop == true, ZIndex = 1, Parent = parent })
	end)
	return ok and w or nil
end
local function rectLines(w, y, hw, hd)
	hd = hd or hw
	local c = { Vector3.new(-hw, y, -hd), Vector3.new(hw, y, -hd), Vector3.new(hw, y, hd), Vector3.new(-hw, y, hd) }
	for i = 1, 4 do w:AddLine(c[i], c[i % 4 + 1]) end
end
local function boxLines(w, hw, hd, y0, y1)
	rectLines(w, y0, hw, hd); rectLines(w, y1, hw, hd)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do w:AddLine(Vector3.new(sx * hw, y0, sz * hd), Vector3.new(sx * hw, y1, sz * hd)) end
	end
end

local hitboxStyles = {}
hitboxStyles.minecraft = function(v, c, r)
	local made = {}
	local hw, bottom = v.w / 2, -3
	local top = bottom + v.h
	local box = wire(r, Color3.new(1, 1, 1), r)
	if not box then return made end
	boxLines(box, hw, hw, bottom, top)
	table.insert(made, box)
	local eyeY = bottom + v.h * 0.9
	local eye = wire(r, Color3.fromRGB(255, 60, 60), r)
	if eye then rectLines(eye, eyeY, hw); table.insert(made, eye) end
	local look = wire(r, Color3.fromRGB(70, 120, 255), r)
	if look then look:AddLine(Vector3.new(0, eyeY, 0), Vector3.new(0, eyeY, -3)); table.insert(made, look) end
	return made
end
hitboxStyles.corners = function(v, c, r)
	local made = {}
	local hw, bottom = v.w / 2, -3
	local top = bottom + v.h
	local w = wire(r, hsv(v.hue, 0.7, 1), r)
	if not w then return made end
	local len = math.min(0.7, v.h / 4)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sy in ipairs({ bottom, top }) do
			for _, sz in ipairs({ -1, 1 }) do
				local p = Vector3.new(sx * hw, sy, sz * hw)
				local dy = (sy == bottom) and len or -len
				w:AddLine(p, p + Vector3.new(-sx * len, 0, 0))
				w:AddLine(p, p + Vector3.new(0, dy, 0))
				w:AddLine(p, p + Vector3.new(0, 0, -sz * len))
			end
		end
	end
	table.insert(made, w)
	return made
end
