setOpen = function(open)
	if unloaded then return end
	isOpen = open
	if open and not welcomeSeen and not welcomeActive then showWelcome() end
	playOpenSound(open)
	if open then
		winScale.Scale = uiScaleBase * 0.9
		menuRoot.Visible = true
		tween(winScale, 0.35, { Scale = uiScaleBase }, Enum.EasingStyle.Back)
		tween(menuBlur, 0.4, { Size = menuBlurSize })
	else
		tween(winScale, 0.18, { Scale = uiScaleBase * 0.94 })
		tween(menuBlur, 0.3, { Size = 0 })
		task.delay(0.2, function() if not isOpen and not unloaded then menuRoot.Visible = false end end)
	end
end

local toggleKeys = { [Enum.KeyCode.RightShift] = true, [Enum.KeyCode.RightControl] = true, [Enum.KeyCode.Insert] = true }
UIS.InputBegan:Connect(function(i)
	if unloaded or UIS:GetFocusedTextBox() then return end
	local kc = i.KeyCode
	if kc == Enum.KeyCode.Unknown then return end
	if listening then
		local m = listening
		listening = nil
		if kc == Enum.KeyCode.Escape or kc == Enum.KeyCode.Backspace then m.bind = nil else m.bind = kc end
		if m.updateBind then m.updateBind() end
		return
	end
	if toggleKeys[kc] then setOpen(not isOpen) return end
	if kc == Enum.KeyCode.F4 and isOpen then searchBox:CaptureFocus() return end
	if kc == Enum.KeyCode.End and disableAll then disableAll.set(true) return end
	for _, m in ipairs(moduleList) do
		if m.bind == kc then m.set(not m.enabled) end
	end
end)

