			local look = cam().CFrame.LookVector
			local ang = math.atan2(look.X, look.Z)
			local n = 0
			for _, d in ipairs(mmSnap()) do
				if d.plr ~= player then
					local off = d.root.Position - r.Position
					local x = off.X * math.cos(ang) - off.Z * math.sin(ang)
					local z = off.X * math.sin(ang) + off.Z * math.cos(ang)
					local px, py = -x / v.range, -z / v.range
