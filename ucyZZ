local BALL, BLOCK, CYL = Enum.PartType.Ball, Enum.PartType.Block, Enum.PartType.Cylinder
local PI, TAU = math.pi, math.pi * 2
local f3d
local function P(shape, size, mat)
	if not f3d or not f3d.Parent then f3d = new("Folder", { Name = "PV_3D", Parent = cam() }) end
	return new("Part", {
		Shape = shape, Size = size, Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
		CastShadow = false, Material = mat or Enum.Material.Neon, Color = Color3.new(1, 1, 1), Parent = f3d,
	})
end
local function hc(v, i, t, step) return hsv(v.hue + i * (step or 10) + (v.rb == 1 and t * 70 or 0), 0.65, 1) end
local function S3(extra, hue)
	local s = {}
	for _, e in ipairs(extra or {}) do s[#s + 1] = e end
	s[#s + 1] = { name = "Оттенок", key = "hue", min = 0, max = 360, default = hue or 200 }
	s[#s + 1] = { name = "Радуга (0/1)", key = "rb", min = 0, max = 1, default = 0 }
	return s
end

-- фабрика 3D-модулей: cfg.count(v), cfg.make(i,v,n,state), cfg.step(i,v,t,n,origin,root,dt,state,part) -> CFrame, Color?, Transparency?
local function fx3d(name, desc, settings, cfg)
	local parts, cfs, st = {}, {}, {}
	local useBulk, lastWarn = true, -10
	local function clear()
		for _, p in ipairs(parts) do pcall(function() p:Destroy() end) end
		parts, cfs, st = {}, {}, {}
	end
	local function build(v)
		clear()
		local n = cfg.count(v)
		for i = 1, n do st[i] = {}; parts[i] = cfg.make(i, v, n, st[i]) end
	end
	mod("3D", {
		name = name, desc = desc, settings = settings,
		onEnable = build, onChange = build, onDisable = clear,
		onRender = function(dt, v)
			local n = #parts
			if n == 0 then return end
			local r = hrp()
			local o
			if cfg.cam then o = cam().CFrame.Position else
				if not r then return end
				o = r.Position
			end
			local t = os.clock()
			-- ошибки в расчёте не выключают модуль, а пишутся в консоль (F9)
			local okStep, err = pcall(function()
				for i = 1, n do
					local cf, col, tr = cfg.step(i, v, t, n, o, r, dt, st[i], parts[i])
					cfs[i] = cf
					if col then parts[i].Color = col end
					if tr then parts[i].Transparency = tr end
				end
			end)
			if not okStep then
				if os.clock() - lastWarn > 3 then lastWarn = os.clock(); warn("[ucyVISUAL] 3D " .. name .. ": " .. tostring(err)) end
				return
			end
			-- быстрый BulkMoveTo, а если он недоступен — обычная установка CFrame
			if useBulk then
				local ok = pcall(workspace.BulkMoveTo, workspace, parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
				if ok then return end
				useBulk = false
			end
			for i = 1, n do
				local p = parts[i]
				if p and p.Parent and cfs[i] then p.CFrame = cfs[i] end
			end
		end,
	})
end

