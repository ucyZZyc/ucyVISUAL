					nameBox.Text = n
					toast("Config loaded: " .. n, true)
					refreshCfg()
				else
					toast("Could not load: " .. n, false)
				end
			end)
			b.MouseButton2Click:Connect(function()
				deleteConfig(n)
				if autoName == n then autoName = nil; writeAuto(nil) end
				if currentConfig == n then currentConfig = nil end
				toast("Config deleted: " .. n, false)
				refreshCfg()
			end)
			cfgDyn[#cfgDyn + 1] = b
		end
		local target = currentConfig or sanitize(nameBox.Text)
		autoSet(autoName ~= nil and autoName == target)
		status.Text = "Current: " .. (currentConfig or "-") .. "    Autoload: " .. (autoName or "off")
	end
	saveB.MouseButton1Click:Connect(function() doSave(nameBox.Text) end)
	refB.MouseButton1Click:Connect(refreshCfg)
	-- переключатель автозагрузки
	for _, c in ipairs(card1:GetChildren()) do
		if c:IsA("Frame") and c.LayoutOrder == 4 then
			local btn = c:FindFirstChildWhichIsA("TextButton")
			if btn then
				btn.MouseButton1Click:Connect(function()
					local target = currentConfig or sanitize(nameBox.Text)
					if target == "" then target = "default" end
					if autoName == target then
						autoName = nil; writeAuto(nil)
						toast("Autoload disabled", false)
					else
						if not readConfig(target) then doSave(target) end
						autoName = target; writeAuto(target)
						toast("Autoload: " .. target, true)
					end
					refreshCfg()
				end)
			end
		end
	end
	cfgRefresh = refreshCfg
	refreshCfg()
end

