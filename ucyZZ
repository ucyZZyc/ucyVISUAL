local function sanitize(n)
	n = string.gsub(n or "", '[\\/:%*%?"<>|%c%.]', "")
	n = string.gsub(n, "^%s+", "")
	n = string.gsub(n, "%s+$", "")
	return string.sub(n, 1, 24)
end
local function toast(text, on)
	local prev = notifyEnabled
	notifyEnabled = true
	notify(text, on)
	notifyEnabled = prev
end

local function snapshot()
	local data = { v = 6, theme = Theme.index or 1, modules = {} }
	for _, m in ipairs(moduleList) do
		if m.name ~= "Disable All" and m.name ~= "Unload Script" then
			local e = { on = m.enabled, vals = {} }
			for k, val in pairs(m.values) do if type(val) == "number" then e.vals[k] = val end end
			if m.bind then e.bind = m.bind.Name end
			data.modules[m.tab .. ":" .. m.name] = e
		end
	end
	return data
end
local function applyConfig(data)
	if type(data) ~= "table" or type(data.modules) ~= "table" then return false end
	local prevSound = soundReady
	soundReady = false
	notifyEnabled = false
	if data.theme and Palettes[data.theme] then setPalette(data.theme) end
	for _, m in ipairs(moduleList) do
		local e = data.modules[m.tab .. ":" .. m.name]
		if type(e) == "table" then
			for k, val in pairs(e.vals or {}) do
				if m.values[k] ~= nil and type(val) == "number" then m.values[k] = val end
			end
			m.bind = nil
			if e.bind then pcall(function() m.bind = Enum.KeyCode[e.bind] end) end
			m.rebuildUI()
			if e.on then
				if m.enabled then
					if m.def.onChange then safe(m.def.onChange, m.values) end
				else
					m.set(true)
				end
			else
				m.set(false)
			end
		end
	end
	for _, m in ipairs(moduleList) do if m.name == "Notifications" then notifyEnabled = m.enabled end end
	soundReady = prevSound
	applyFilter()
	return true
end

local function writeConfig(name, data)
	local json = HttpService:JSONEncode(data)
	if hasFS then
		fsEnsure()
		return (pcall(writefile, cfgPath(name), json))
	end
	memFiles[name] = json
	return true
end
local function readConfig(name)
	local json
	if hasFS then
		local ok, r = pcall(readfile, cfgPath(name))
		if ok then json = r end
	else
		json = memFiles[name]
	end
	if not json then return nil end
	local ok, d = pcall(function() return HttpService:JSONDecode(json) end)
	return ok and d or nil
end
local function listConfigs()
	local out = {}
	if hasFS then
		fsEnsure()
		local ok, files = pcall(listfiles, CFG_DIR .. "/configs")
		if ok and type(files) == "table" then
			for _, f in ipairs(files) do
				local n = string.match(f, "([^/\\]+)%.json$")
				if n then out[#out + 1] = n end
			end
		end
	else
		for n in pairs(memFiles) do out[#out + 1] = n end
	end
	table.sort(out)
	return out
end
local function deleteConfig(name)
	if hasFS then pcall(function() if delfile then delfile(cfgPath(name)) end end) else memFiles[name] = nil end
end
local function readAuto()
	if hasFS then
		local ok, r = pcall(function() if isfile(CFG_DIR .. "/autoload.txt") then return readfile(CFG_DIR .. "/autoload.txt") end end)
		if ok and r and r ~= "" then return r end
		return nil
	end
	return memAuto
end
local function writeAuto(n)
	if hasFS then fsEnsure(); pcall(writefile, CFG_DIR .. "/autoload.txt", n or "") else memAuto = n end
end

