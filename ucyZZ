		onDisable = function() if orig then cam().FieldOfView = orig end end,
	})
end
do
	local zooming, base = false, 70
	UIS.InputBegan:Connect(function(i, gp) if not gp and i.KeyCode == Enum.KeyCode.C then zooming = true end end)
	UIS.InputEnded:Connect(function(i) if i.KeyCode == Enum.KeyCode.C then zooming = false end end)
	mod("Camera", {
		name = "Zoom", desc = "Удерживайте C для приближения",
		settings = { { name = "FOV при зуме", key = "z", min = 10, max = 60, default = 25 } },
		onEnable = function() base = cam().FieldOfView end,
		onRender = function(dt, v)
			local c = cam()
			c.FieldOfView = c.FieldOfView + ((zooming and v.z or base) - c.FieldOfView) * math.clamp(dt * 14, 0, 1)
		end,
		onDisable = function() cam().FieldOfView = base end,
	})
end
do
	local base
	mod("Camera", {
		name = "Dynamic FOV", desc = "FOV растёт со скоростью",
		settings = { { name = "Множитель", key = "k", min = 0.05, max = 1, default = 0.35, step = 0.05 } },
		onEnable = function() base = cam().FieldOfView end,
		onRender = function(dt, v)
			local r = hrp()
			if not r then return end
			local vel = r.AssemblyLinearVelocity
			local sp = Vector3.new(vel.X, 0, vel.Z).Magnitude
			local c = cam()
			c.FieldOfView = c.FieldOfView + ((base + math.clamp(sp * v.k, 0, 35)) - c.FieldOfView) * math.clamp(dt * 8, 0, 1)
		end,
		onDisable = function() if base then cam().FieldOfView = base end end,
	})
end
do
	local blur = new("BlurEffect", { Name = "PV_MotionBlur", Size = 0, Parent = Lighting })
	local lastLook
	mod("Camera", {
		name = "Motion Blur", desc = "Размытие при быстром повороте камеры",
		settings = { { name = "Сила", key = "s", min = 1, max = 20, default = 8 } },
		onEnable = function() lastLook = cam().CFrame.LookVector end,
		onRender = function(dt, v)
			local look = cam().CFrame.LookVector
			local speed = (look - (lastLook or look)).Magnitude / math.max(dt, 1e-3)
			lastLook = look
			blur.Size = blur.Size + (math.clamp(speed * v.s * 0.6, 0, 40) - blur.Size) * 0.25
		end,
		onDisable = function() blur.Size = 0 end,
	})
end
do
	local roll = 0
	mod("Camera", {
		name = "Camera Tilt", desc = "Наклон камеры при движении вбок",
		settings = {
			{ name = "Чувствительность", key = "k", min = 0.05, max = 1, default = 0.25, step = 0.05 },
			{ name = "Макс. угол", key = "max", min = 1, max = 15, default = 6 },
		},
		onRender = function(dt, v)
			local r = hrp()
			if not r then return end
			local c = cam()
			local side = r.AssemblyLinearVelocity:Dot(c.CFrame.RightVector)
			roll = roll + (math.clamp(-side * v.k, -v.max, v.max) - roll) * math.clamp(dt * 8, 0, 1)
			c.CFrame = c.CFrame * CFrame.Angles(0, 0, math.rad(roll))
		end,
		onDisable = function() roll = 0 end,
	})
end
do
	local t = 0
	mod("Camera", {
		name = "Head Bob", desc = "Покачивание камеры при ходьбе",
		settings = {
			{ name = "Амплитуда", key = "a", min = 0.05, max = 0.6, default = 0.2, step = 0.05 },
			{ name = "Скорость", key = "s", min = 4, max = 16, default = 9 },
		},
		onRender = function(dt, v)
			local h = hum()
			if not h then return end
			local goal = Vector3.zero
			if h.MoveDirection.Magnitude > 0.1 then
				t += dt * v.s
				goal = Vector3.new(math.sin(t) * 0.5 * v.a, math.abs(math.cos(t)) * v.a, 0)
			end
			h.CameraOffset = h.CameraOffset:Lerp(goal, 0.25)
		end,
		onDisable = function() local h = hum() if h then h.CameraOffset = Vector3.zero end end,
	})
end
