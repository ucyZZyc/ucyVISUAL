local function addModule(tabName, def)
	local m = { name = def.name, tab = tabName, enabled = false, values = {}, def = def, bind = nil }
	table.insert(moduleList, m)
	m.idx = #moduleList
	for _, s in ipairs(def.settings or {}) do m.values[s.key] = s.default end
	if not def.hidden then makeArrayLabel(def.name) end

	function m.refreshVisual()
		if m.setEnVisual then m.setEnVisual(m.enabled) end
		if m.titleGrad then m.titleGrad.Enabled = m.enabled end
	end
	function m.updateBind()
		if m.bindBtn and m.bindBtn.Parent then
			m.bindBtn.Text = (listening == m) and "press key..." or (m.bind and m.bind.Name or "None")
		end
	end
	function m.rebuildUI()
		if m.card then m.card:Destroy(); m.card = nil; m.bindBtn = nil; m.setEnVisual = nil; m.titleGrad = nil end
		local pg = pages[tabName]
		if pg then pg.built = false end
	end
	function m.set(on)
		if m.enabled == on then return end
		m.enabled = on
		m.refreshVisual()
		local pl = arrayLabels[def.name]
		if pl then pl.Visible = on end
		if on and def.onEnable then safe(def.onEnable, m.values) end
		if not on and def.onDisable then safe(def.onDisable, m.values) end
		if not def.hidden then
			notify(def.name .. (on and " включён" or " выключен"), on)
			playSound(soundIds[2], on and 1.25 or 0.9)
		end
	end
	return m
end

local bootErrors = 0
local function mod(tab, def)
	local ok, m = pcall(addModule, tab, def)
	if not ok then
		bootErrors += 1
		warn("[ucyVISUAL] модуль " .. tostring(def.name) .. ": " .. tostring(m))
		return nil
	end
	return m
end

