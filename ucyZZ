local function hitboxModule(name, desc, styleKey, withColor, withFill)
	local attached, acc = {}, 0
	local function clearChar(c)
		local l = attached[c]
		if l then for _, o in ipairs(l) do pcall(function() o:Destroy() end) end attached[c] = nil end
	end
	local function clearAll() for c in pairs(attached) do clearChar(c) end end
	local function targets(v)
		local out = {}
		if player.Character then table.insert(out, player.Character) end
		if v.others >= 1 then
			for _, p in ipairs(Players:GetPlayers()) do if p ~= player and p.Character then table.insert(out, p.Character) end end
		end
		if v.others >= 2 then
			for _, o in ipairs(workspace:GetChildren()) do
				if o:IsA("Model") and not Players:GetPlayerFromCharacter(o) and o:FindFirstChildOfClass("Humanoid") then table.insert(out, o) end
			end
		end
		return out
	end
	local function sync(v)
		local want = {}
		for _, c in ipairs(targets(v)) do want[c] = true end
		for c in pairs(attached) do if not want[c] or not c.Parent then clearChar(c) end end
		for c in pairs(want) do
			if not attached[c] then
				local r = c:FindFirstChild("HumanoidRootPart")
				if r then attached[c] = hitboxStyles[styleKey](v, c, r) or {} end
			end
		end
	end
	local settings = {
		{ name = "Ширина", key = "w", min = 1, max = 5, default = 2.2, step = 0.1 },
		{ name = "Высота", key = "h", min = 3, max = 8, default = 5.6, step = 0.1 },
		{ name = "Цели: 0 я / 1 игроки / 2 +NPC", key = "others", min = 0, max = 2, default = 0 },
	}
	if withColor then table.insert(settings, { name = "Оттенок", key = "hue", min = 0, max = 360, default = 140 }) end
	if withFill then table.insert(settings, { name = "Прозрачность", key = "tr", min = 0.2, max = 0.95, default = 0.6, step = 0.05 }) end
	mod("Hitbox", {
		name = name, desc = desc, settings = settings,
		onEnable = function(v) sync(v) end,
		onChange = function(v) clearAll(); sync(v) end,
		onChar = function(v) clearAll(); sync(v) end,
		onRender = function(dt, v) acc += dt; if acc > 0.5 then acc = 0; sync(v) end end,
		onDisable = clearAll,
	})
end
